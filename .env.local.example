DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sales_crm
# Optional session secret
SESSION_SECRET=change-me-in-production
APP_ORIGINS=https://your-crm.example.com
TRUST_PROXY=true
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=

# 仅限本地开发。生产环境不要设置或必须保持 false
DEV_DEMO_LOGIN=true
# DEV_ADMIN_PASSWORD=
# DEV_COMPANY_PASSWORD=
# DEV_MANAGER_PASSWORD=
# DEV_SALES_PASSWORD=

# AI锛欰PI Key 鍏ㄥ眬鍏辩敤锛涙瘡瀹跺叕鍙稿湪銆屽叕鍙哥鐞?鈫?AI 閰嶇疆銆嶇粦瀹氭櫤鑳戒綋涓庣煡璇嗗簱 ID
